---
import "../styles/global.css";
import ProgressBadge from "../components/ProgressBadge";

interface Props { title: string; description?: string; wide?: boolean }
const { title, description = "매일 5분, 읽고 꺼내고 다시. 오픈소스 CS 학습 뉴스레터.", wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(/\/$/, "");

// 현재 페이지 표시: 글 페이지(/issues/...)는 "지난 호"로 친다
const nav = [
  { href: `${base}/`, label: "지난 호", active: path === base || path.startsWith(`${base}/issues`) },
  { href: `${base}/glossary/`, label: "용어 사전", active: path.startsWith(`${base}/glossary`) },
  { href: `${base}/settings/`, label: "AI 연결", active: path.startsWith(`${base}/settings`) },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Do+Hyeon&family=IBM+Plex+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@500&display=swap" />
  </head>
  <body>
    <div class:list={["wrap", { wide }]}>
      <header class="top">
        <a class="brand" href={`${base}/`}><span>CS 한 입</span></a>
        <nav class="nav" aria-label="사이트">
          {nav.map((n) => <a href={n.href} aria-current={n.active ? "page" : undefined}>{n.label}</a>)}
          <a class="nav-ext" href="https://github.com/wonby1n/cs-hanip">GitHub ↗</a>
        </nav>
        <ProgressBadge client:load />
      </header>
      <main><slot /></main>
      <footer class="foot">
        코드는 MIT, 콘텐츠는 CC BY-NC-SA 4.0. 틀린 내용을 찾으면 <a href="https://github.com/wonby1n/cs-hanip/issues/new/choose">이슈로 알려주세요</a>.
      </footer>
    </div>
  </body>
</html>
